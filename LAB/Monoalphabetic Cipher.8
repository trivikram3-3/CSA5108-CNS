#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char keyword[100];
    char cipherAlphabet[26];
    char plaintext[200];
    char ciphertext[200];

    int used[26] = {0};
    int i, j = 0;
    char ch;

    printf("Enter keyword: ");
    scanf("%s", keyword);

    /* Convert keyword to uppercase */
    for (i = 0; keyword[i] != '\0'; i++) {
        keyword[i] = toupper(keyword[i]);
    }

    /* Create cipher alphabet using keyword */
    for (i = 0; keyword[i] != '\0'; i++) {
        ch = keyword[i];

        if (ch >= 'A' && ch <= 'Z' && used[ch - 'A'] == 0) {
            cipherAlphabet[j++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    /* Add remaining unused alphabet letters */
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (used[ch - 'A'] == 0) {
            cipherAlphabet[j++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    cipherAlphabet[26] = '\0';

    printf("\nPlain Alphabet : ABCDEFGHIJKLMNOPQRSTUVWXYZ\n");
    printf("Cipher Alphabet: %s\n", cipherAlphabet);

    /* Clear input buffer */
    getchar();

    printf("\nEnter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    /* Encryption */
    for (i = 0; plaintext[i] != '\0'; i++) {

        if (isupper(plaintext[i])) {
            ciphertext[i] = cipherAlphabet[plaintext[i] - 'A'];
        }
        else if (islower(plaintext[i])) {
            ciphertext[i] =
                tolower(cipherAlphabet[plaintext[i] - 'a']);
        }
        else {
            ciphertext[i] = plaintext[i];
        }
    }

    ciphertext[i] = '\0';

    printf("Ciphertext: %s", ciphertext);

    return 0;
}






















