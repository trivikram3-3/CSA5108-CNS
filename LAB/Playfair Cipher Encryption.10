#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M', 'F', 'H', 'I', 'K'},
    {'U', 'N', 'O', 'P', 'Q'},
    {'Z', 'V', 'W', 'X', 'Y'},
    {'E', 'L', 'A', 'R', 'G'},
    {'D', 'S', 'T', 'B', 'C'}
};

/* Find position of a character in the matrix */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Encrypt one pair */
void encryptPair(char a, char b, char *x, char *y) {
    int r1, c1, r2, c2;

    findPosition(a, &r1, &c1);
    findPosition(b, &r2, &c2);

    /* Same row */
    if (r1 == r2) {
        *x = matrix[r1][(c1 + 1) % 5];
        *y = matrix[r2][(c2 + 1) % 5];
    }

    /* Same column */
    else if (c1 == c2) {
        *x = matrix[(r1 + 1) % 5][c1];
        *y = matrix[(r2 + 1) % 5][c2];
    }

    /* Rectangle rule */
    else {
        *x = matrix[r1][c2];
        *y = matrix[r2][c1];
    }
}

int main() {
    char message[] =
        "MUST SEE YOU OVER CADOGAN WEST. COMING AT ONCE.";

    char text[200];
    char encrypted[200];

    int i, j = 0;
    char a, b;

    /* Remove spaces and punctuation */
    for (i = 0; message[i] != '\0'; i++) {
        if (isalpha(message[i])) {
            text[j++] = toupper(message[i]);
        }
    }

    text[j] = '\0';

    /* If odd length, add X */
    if (strlen(text) % 2 != 0) {
        text[j++] = 'X';
        text[j] = '\0';
    }

    /* Encrypt pairs */
    j = 0;

    for (i = 0; text[i] != '\0'; i += 2) {
        encryptPair(text[i], text[i + 1],
                    &encrypted[j], &encrypted[j + 1]);
        j += 2;
    }

    encrypted[j] = '\0';

    printf("Playfair Matrix:\n");

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    printf("\nPlaintext:\n");
    printf("%s\n", message);

    printf("\nPrepared Text:\n");
    printf("%s\n", text);

    printf("\nEncrypted Text:\n");
    printf("%s\n", encrypted);

    return 0;
}











