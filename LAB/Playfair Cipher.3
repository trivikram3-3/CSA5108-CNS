#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create the 5x5 Playfair matrix */
void createMatrix(char key[]) {
    int used[26] = {0};
    int row = 0, col = 0;
    int i;
    char ch;

    // I and J are treated as the same
    used['J' - 'A'] = 1;

    // Add keyword letters
    for (i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);

        if (ch < 'A' || ch > 'Z')
            continue;

        if (ch == 'J')
            ch = 'I';

        if (!used[ch - 'A']) {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;
            if (col == 5) {
                col = 0;
                row++;
            }
        }
    }

    // Add remaining alphabet letters
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (ch == 'J')
            continue;

        if (!used[ch - 'A']) {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;
            if (col == 5) {
                col = 0;
                row++;
            }
        }
    }
}

/* Find the position of a letter */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Prepare plaintext into pairs */
void prepareText(char input[], char output[]) {
    int i = 0, j = 0;
    char a, b;

    while (input[i] != '\0') {
        if (isalpha(input[i])) {
            a = toupper(input[i]);

            if (a == 'J')
                a = 'I';

            i++;

            while (input[i] != '\0' && !isalpha(input[i]))
                i++;

            if (input[i] == '\0') {
                output[j++] = a;
                output[j++] = 'X';
                break;
            }

            b = toupper(input[i]);

            if (b == 'J')
                b = 'I';

            if (a == b) {
                output[j++] = a;
                output[j++] = 'X';
            } else {
                output[j++] = a;
                output[j++] = b;
                i++;
            }
        } else {
            i++;
        }
    }

    output[j] = '\0';
}

/* Encrypt the prepared plaintext */
void encrypt(char text[], char cipher[]) {
    int i;
    int r1, c1, r2, c2;

    for (i = 0; text[i] != '\0'; i += 2) {
        findPosition(text[i], &r1, &c1);
        findPosition(text[i + 1], &r2, &c2);

        // Same row
        if (r1 == r2) {
            cipher[i] = matrix[r1][(c1 + 1) % 5];
            cipher[i + 1] = matrix[r2][(c2 + 1) % 5];
        }

        // Same column
        else if (c1 == c2) {
            cipher[i] = matrix[(r1 + 1) % 5][c1];
            cipher[i + 1] = matrix[(r2 + 1) % 5][c2];
        }

        // Rectangle rule
        else {
            cipher[i] = matrix[r1][c2];
            cipher[i + 1] = matrix[r2][c1];
        }
    }

    cipher[i] = '\0';
}

int main() {
    char key[100];
    char plaintext[200];
    char prepared[200];
    char ciphertext[200];
    int i, j;

    printf("Enter the keyword: ");
    fgets(key, sizeof(key), stdin);

    printf("Enter the plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    createMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    prepareText(plaintext, prepared);

    encrypt(prepared, ciphertext);

    printf("\nPrepared Plaintext: %s\n", prepared);
    printf("Encrypted Text: %s\n", ciphertext);

    return 0;
}









