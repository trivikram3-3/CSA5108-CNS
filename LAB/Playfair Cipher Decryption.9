#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create Playfair matrix */
void createMatrix(char key[]) {
    int used[26] = {0};
    int row = 0, col = 0;
    int i;
    char ch;

    used['J' - 'A'] = 1;   // I and J are combined

    /* Add key letters */
    for (i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);

        if (ch < 'A' || ch > 'Z')
            continue;

        if (ch == 'J')
            ch = 'I';

        if (!used[ch - 'A']) {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;

            if (col == 5) {
                col = 0;
                row++;
            }
        }
    }

    /* Add remaining letters */
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (ch == 'J')
            continue;

        if (!used[ch - 'A']) {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;

            if (col == 5) {
                col = 0;
                row++;
            }
        }
    }
}

/* Find position of a letter */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Decrypt Playfair ciphertext */
void decrypt(char cipher[], char plain[]) {
    int i;
    int r1, c1, r2, c2;

    for (i = 0; cipher[i] != '\0'; i += 2) {

        findPosition(cipher[i], &r1, &c1);
        findPosition(cipher[i + 1], &r2, &c2);

        /* Same row */
        if (r1 == r2) {
            plain[i] = matrix[r1][(c1 + 4) % 5];
            plain[i + 1] = matrix[r2][(c2 + 4) % 5];
        }

        /* Same column */
        else if (c1 == c2) {
            plain[i] = matrix[(r1 + 4) % 5][c1];
            plain[i + 1] = matrix[(r2 + 4) % 5][c2];
        }

        /* Rectangle rule */
        else {
            plain[i] = matrix[r1][c2];
            plain[i + 1] = matrix[r2][c1];
        }
    }

    plain[i] = '\0';
}

int main() {

    char key[] = "MONARCHY";

    char ciphertext[] =
        "KXJEYUREBEZWEHEWRYTUHEYFS"
        "KREHEGOYFIWTTTUOLKSYCAJPO"
        "BOTEIZONTXBYBNTGONE YCUZWR"
        "GDSONSXBOUYWRHEBAAHYUSEDQ";

    char cleanCipher[200];
    char plaintext[200];

    int i, j = 0;

    /* Remove spaces */
    for (i = 0; ciphertext[i] != '\0'; i++) {
        if (ciphertext[i] != ' ')
            cleanCipher[j++] = ciphertext[i];
    }

    cleanCipher[j] = '\0';

    createMatrix(key);

    printf("Playfair Matrix:\n");

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    decrypt(cleanCipher, plaintext);

    printf("\nCiphertext:\n");
    printf("KXJEY UREBE ZWEHE WRYTU HEYFS\n");
    printf("KREHE GOYFI WTTTU OLKSY CAJPO\n");
    printf("BOTEI ZONTX BYBNT GONEY CUZWR\n");
    printf("GDSON SXBOU YWRHE BAAHY USEDQ\n");

    printf("\nDecrypted Text:\n");
    printf("%s\n", plaintext);

    return 0;
}













